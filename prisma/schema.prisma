generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String         @id @default(uuid())
  name                    String
  email                   String?        @unique
  password                String?
  isActive                Boolean        @default(true)
  isVerified              Boolean        @default(false)
  authMethod              String?        @default("EMAIL")
  socialId                String?
  fcmToken                String?
  lastLoginAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  phone                   String?        @unique
  image                   String?
  emailNotifications      Boolean        @default(true)
  marketingCommunications Boolean        @default(false)
  pushNotifications       Boolean        @default(true)
  carts                   Cart[]
  favourites              Favourite[]
  orders                  Order[]
  otpCodes                OtpCode[]
  refreshTokens           RefreshToken[]
  vehicles                Vehicle[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model BlacklistedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("blacklisted_tokens")
}

model Vehicle {
  id        String   @id @default(uuid())
  userId    String
  make      String
  model     String
  plateNo   String   @unique
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("vehicles")
}

model Category {
  id              String           @id @default(uuid())
  name            String
  categoryOptions CategoryOption[]
  items           Item[]
  addOns          AddOn[]

  @@map("categories")
}

model Item {
  id            String      @id @default(uuid())
  categoryId    String
  name          String
  stock         Int         @default(0)
  currentPrice  Decimal     @db.Decimal(10, 2)
  detail        String?
  previousPrice Decimal?    @db.Decimal(10, 2)
  rating        Float       @default(0)
  cartItems     CartItem[]
  favourites    Favourite[]
  images        ItemImage[]
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]

  @@map("items")
}

model ItemImage {
  id        String  @id @default(uuid())
  itemId    String
  imageUrl  String
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("item_images")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id              String           @id @default(uuid())
  cartId          String
  itemId          String
  quantity        Int              @default(1)
  cartItemAddOns  CartItemAddOn[]
  cartItemOptions CartItemOption[]
  cart            Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  item            Item             @relation(fields: [itemId], references: [id])

  @@unique([cartId, itemId])
  @@map("cart_items")
}

model CartItemOption {
  id               String         @id @default(uuid())
  cartItemId       String
  categoryOptionId String
  cartItem         CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  categoryOption   CategoryOption @relation(fields: [categoryOptionId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, categoryOptionId])
  @@map("cart_item_options")
}

model CartItemAddOn {
  id         String   @id @default(uuid())
  cartItemId String
  addOnId    String
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@unique([cartItemId, addOnId])
  @@map("cart_item_add_ons")
}

model CategoryOption {
  id              String           @id @default(uuid())
  categoryId      String
  optionType      String
  name            String
  extraPrice      Decimal          @default(0) @db.Decimal(10, 2)
  cartItemOptions CartItemOption[]
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, optionType, name])
  @@map("category_options")
}

model AddOn {
  id              String           @id @default(uuid())
  categoryId      String
  name            String
  price           Decimal          @db.Decimal(10, 2)
  isActive        Boolean          @default(true)
  cartItemAddOns  CartItemAddOn[]
  orderItemAddOns OrderItemAddOn[]
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("add_ons")
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  serviceType   ServiceType
  pickupType    PickupType?
  scheduledTime DateTime?
  contactPhone  String?
  vehicleId     String?
  paymentMethod PaymentMethod @default(CASH)
  cardNumber    String?
  cardExpiry    String?
  cardCvc       String?
  cardHolder    String?
  subtotal      Decimal       @db.Decimal(10, 2)
  platformFee   Decimal       @db.Decimal(10, 2)
  gst           Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderItems    OrderItem[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@map("orders")
}

model OrderItem {
  id               String            @id @default(uuid())
  orderId          String
  itemId           String
  quantity         Int               @default(1)
  basePrice        Decimal           @db.Decimal(10, 2)
  orderItemAddOns  OrderItemAddOn[]
  orderItemOptions OrderItemOption[]
  item             Item              @relation(fields: [itemId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderItemOption {
  id          String    @id @default(uuid())
  orderItemId String
  optionType  String
  optionValue String
  extraPrice  Decimal   @default(0) @db.Decimal(10, 2)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_options")
}

model OrderItemAddOn {
  id          String    @id @default(uuid())
  orderItemId String
  addOnId     String
  quantity    Int       @default(1)
  price       Decimal   @db.Decimal(10, 2)
  addOn       AddOn     @relation(fields: [addOnId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@map("order_item_add_ons")
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("favourites")
}



enum PaymentMethod {
  CASH
  CARD
  APPLE_PAY
}

enum ServiceType {
  PICKUP
  DRIVE_THROUGH
}

enum PickupType {
  STANDARD
  SCHEDULED
}

enum OrderStatus {
  PENDING
  COMPLETED
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  LOGIN_VERIFICATION
}
